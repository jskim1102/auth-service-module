# auth-service environment template. Copy to .env and fill real values.
# .env is gitignored — never commit real secrets (RULES §3/§4.1, F12).

# Port offset for this module (RULES §4: 시작포트 + (PORT_OFFSET - 1)).
PORT_OFFSET=
# Host-published ports (derived from offset; container ports are fixed internally).
BACKEND_PORT=              # auth-service FastAPI/uvicorn (예: 8000 + offset)
FRONTEND_PORT=             # demo frontend (예: 5173 + offset)
POSTGRES_PORT=5435         # 공유 pg 고정 호스트 포트 (offset 무관, container 5432)
MAILHOG_SMTP_PORT=         # MailHog SMTP (예: 1025 + offset)
MAILHOG_HTTP_PORT=         # MailHog web UI (예: 8025 + offset)

# Postgres connection. DATABASE_URL targets the compose service name + container port 5432.
# Username/db are public; the password is a secret → placeholder here, real value in .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=auth
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@postgres:5432/auth
# Test-only DB URL: host-run pytest (.venv) reaches the published port
# localhost:POSTGRES_PORT (5435). NOT part of app Settings — read directly by the
# test suite. The app always uses the in-network DATABASE_URL above. Use a SEPARATE
# `auth_test` db (not the live `auth`) so the test cleanup never wipes live data.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5435/auth_test

# JWT — RS256 (spec Decisions: host verifies with public key, secret not shared).
# Generate a keypair, e.g.:
#   openssl genpkey -algorithm RSA -out keys/jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in keys/jwt_private.pem -out keys/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
ACCESS_TTL=900             # access token TTL seconds (<= 900 per spec)
REFRESH_TTL=1209600        # refresh token TTL seconds (14 days)

# SMTP — dev uses MailHog (compose service). SMTP host port is MAILHOG_SMTP_PORT.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@auth.local
# Optional auth + STARTTLS for real SMTP. Empty user/pass + STARTTLS=false = MailHog.
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# --- Real Gmail example (uncomment + fill to send real email) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<16-char Google App Password>   # NOT your account password
# SMTP_FROM=you@gmail.com

# SNS OAuth provider credentials — obtain per provider, fill in .env (never here).
NAVER_CLIENT_ID=CHANGEME
NAVER_CLIENT_SECRET=CHANGEME
KAKAO_CLIENT_ID=CHANGEME
KAKAO_CLIENT_SECRET=CHANGEME
GOOGLE_CLIENT_ID=CHANGEME
GOOGLE_CLIENT_SECRET=CHANGEME

# Per-provider OAuth scope (overrides the built-in default; empty = omit scope param).
# Kakao EMPTY: pre-review apps can't request account_email (→ invalid_scope at authorize).
# After Kakao business-app email review, set KAKAO_SCOPE=account_email to receive email.
GOOGLE_SCOPE=openid email profile
NAVER_SCOPE=name email
KAKAO_SCOPE=

# Security whitelists — comma-separated. redirect_uri + CORS allowlists (F12).
ALLOWED_REDIRECT_URIS=http://localhost:5176/auth/callback
CORS_ORIGINS=http://localhost:5176
# Base the provider redirect_uri is built from (must match what you register with
# the SNS provider). Demo pins the host origin; falls back to request base if unset.
OAUTH_REDIRECT_BASE=http://localhost:5176

# Public base URL the user reaches the app at — used to build the password-reset
# email link {APP_BASE_URL}/reset?token=... (#32). Set to your public/tunnel host.
APP_BASE_URL=http://localhost:5176

# Refresh-cookie Secure flag — true = HTTPS-only (default). Set false ONLY for
# local http dev (e.g. http://localhost). Production / any HTTPS deploy → true.
COOKIE_SECURE=true
